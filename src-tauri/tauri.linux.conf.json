{
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "CrimeClient Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 690,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0e0e0f",
        "center": true,
        "visible": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "appimage",
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "games"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
